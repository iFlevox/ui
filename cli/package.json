{
  "name": "iflevox-ui",
  "version": "0.1.0",
  "description": "Next-generation CLI tool to add production-ready kinetic UI components directly to your project",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "iflevox-ui": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch"
  },
  "keywords": [
    "iflevox-ui",
    "ui",
    "cli",
    "components",
    "framer-motion",
    "radix-ui",
    "tailwind",
    "react19",
    "nextjs"
  ],
  "author": "iFlevox Architecture Team <hello@iflevox.uz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iFlevox/iFlevox-website.git",
    "directory": "cli"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.6",
    "typescript": "^5.5.4"
  }
}
